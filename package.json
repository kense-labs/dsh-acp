{
  "name": "@kense-labs/dsh-acp",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.9.0"
  },
  "workspaces": [
    "vendor/*",
    "packages/*/*",
    "native/system",
    "native/system/packages/*",
    "apps/cli"
  ],
  "scripts": {
    "build": "pnpm run build:native-system && pnpm run build:typert && pnpm run build:lib && pnpm run build:assemble",
    "build:native-system": "node --import tsx/esm native/system/scripts/build.ts --host-addon-only",
    "build:typert": "node --import tsx/esm scripts/generate-typert.ts",
    "build:lib": "node node_modules/typescript/bin/tsc -b tsconfig.host.json",
    "build:assemble": "node scripts/assemble-lib.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc -b tsconfig.host.json",
    "test": "node node_modules/vitest/vitest.mjs run --config vitest.acp.config.ts",
    "test:acp": "pnpm test",
    "dsh": "node --import tsx/esm apps/cli/src/bin.ts",
    "start": "node apps/cli/lib/bin.js --profile acp"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/hosted-git-info": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@types/semver": "^7.8.0",
    "@types/ws": "8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
